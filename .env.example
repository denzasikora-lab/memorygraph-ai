# CockroachDB Cloud connection string. Never commit a real password.
MEMORYGRAPH_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
MEMORYGRAPH_EMBEDDING_DIMENSIONS=64
MEMORYGRAPH_MOCK_LLM=true

# Optional AWS integration. When unset, artifacts are kept locally in backend/.artifacts.
MEMORYGRAPH_AWS_REGION=us-east-1
MEMORYGRAPH_S3_BUCKET=
